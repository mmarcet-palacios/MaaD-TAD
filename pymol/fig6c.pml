# fig6c.pml -- Fig 6C: the I11/I12 hairpin (chr1:13.06-13.17 Mb) with mirror-image gene pairs facing each other
# Load only blocks 29-40 (they hold nucleosomes 1455-2012); the full model is not needed.
# Then:  @fig6c.pml   -> colours genes, draws dashed lines joining the centres of mirror-image genes, stores view fig6C
set suspend_updates, on
bg_color white
set ray_opaque_background, 1
set depth_cue, 0
set_color hp_dna, [0.62, 0.60, 0.56]
set_color hp_hist, [0.84, 0.82, 0.78]
