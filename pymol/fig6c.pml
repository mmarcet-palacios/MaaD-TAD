# HNRNPCL4 13,163,914-13,165,631
color g_hnrnpcl, (chain A and resi 392569-394286) or (chain B and resi 257715-259432)
color g_hnrnpcl, chain P2002*+P2003*+P2004*+P2005*+P2006*+P2007*+P2008*+P2009*+P2010*
# dashed lines joining the centres of mirror-image gene pairs (centre = mean position of the gene's DNA atoms)
python
from pymol import cmd
GENES = {"PRAMEF25": "(chain A and resi 297332-306539) or (chain B and resi 345462-354669)",
         "PRAMEF26": "(chain A and resi 377560-386771) or (chain B and resi 265230-274441)",
         "PRAMEF34P": "(chain A and resi 323834-326626) or (chain B and resi 325375-328167)",
         "PRAMEF36P": "(chain A and resi 357473-360270) or (chain B and resi 291731-294528)",
         "HNRNPCL3": "(chain A and resi 289424-291533) or (chain B and resi 360468-362577)",
         "HNRNPCL4": "(chain A and resi 392569-394286) or (chain B and resi 257715-259432)"}
for g, sel in GENES.items():
    xyz = cmd.get_coords(sel)
    c = [float(v) for v in xyz.mean(0)]
    cmd.pseudoatom("gc_" + g, pos=c)
    print("%-10s centre %8.1f %8.1f %8.1f  (%d atoms)" % (g, c[0], c[1], c[2], len(xyz)))
cmd.delete("mirror_pairs")
for a, b in (("PRAMEF25", "PRAMEF26"), ("PRAMEF34P", "PRAMEF36P"), ("HNRNPCL3", "HNRNPCL4")):
    cmd.distance("mirror_pairs", "gc_" + a, "gc_" + b)
cmd.hide("labels", "mirror_pairs")
cmd.hide("everything", "gc_*")
python end
set dash_color, black, mirror_pairs
set dash_radius, 8, mirror_pairs
set dash_length, 35, mirror_pairs
set dash_gap, 30, mirror_pairs
set dash_round_ends, 1, mirror_pairs
deselect
set suspend_updates, off
set_view (-0.660968, 0.162492, 0.732611, 0.707921, 0.458882, 0.536913, -0.248938, 0.873512, -0.418337, 0.0, 0.0, -13808.03, -1756.97, 302.75, 614.72, 10988.1, 16628.0, -20.0)
view fig6C, store
